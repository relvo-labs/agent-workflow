{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relvo-labs.github.io/agent-workflow/schemas/0.1/checkpoint.schema.json",
  "title": "checkpoint",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1"
    },
    "kind": {
      "const": "Checkpoint"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "provider",
        "session",
        "repository",
        "worktree",
        "branch",
        "issue",
        "pr",
        "base"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "running",
        "paused",
        "blocked",
        "completed",
        "cancelled"
      ]
    },
    "process_state": {
      "enum": [
        "inflight",
        "quiescent",
        "unknown"
      ]
    },
    "queue_cancelled": {
      "type": "boolean"
    },
    "history_persisted": {
      "type": "boolean"
    },
    "durable": {
      "type": "boolean"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "session": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "worktree": {
                  "type": "string",
                  "minLength": 1
                },
                "branch": {
                  "type": "string",
                  "minLength": 1
                },
                "issue": {
                  "type": "string",
                  "minLength": 1
                },
                "pr": {
                  "type": "string",
                  "minLength": 1
                },
                "base": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "provider",
                "session",
                "repository",
                "worktree",
                "branch",
                "issue",
                "pr",
                "base"
              ]
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "session": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "worktree": {
                  "type": "string",
                  "minLength": 1
                },
                "branch": {
                  "type": "string",
                  "minLength": 1
                },
                "issue": {
                  "type": "string",
                  "minLength": 1
                },
                "pr": {
                  "type": "string",
                  "minLength": 1
                },
                "base": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "provider",
                "session",
                "repository",
                "worktree",
                "branch",
                "issue",
                "pr",
                "base"
              ]
            },
            "prior_quiescent": {
              "type": "boolean"
            },
            "acknowledged": {
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to",
            "prior_quiescent",
            "acknowledged"
          ]
        }
      ]
    }
  },
  "required": [
    "version",
    "kind",
    "task_id",
    "run_id",
    "identity",
    "sequence",
    "state",
    "process_state",
    "queue_cancelled",
    "history_persisted",
    "durable",
    "next_action",
    "handoff"
  ]
}
